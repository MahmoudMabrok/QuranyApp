{
  "raw_duration": 25.184874999999998,
  "tempo_factor": 0.8394958333333332,
  "duration": 30,
  "scenes": [
    {
      "id": 1,
      "start": 0.0,
      "duration": 4.5108919540001695,
      "text": "مَع قُرْآنِي، خَلِّي لِيك وَقْت مَع الْقُرْآن كُلّ يُوم."
    },
    {
      "id": 2,
      "start": 4.5108919540001695,
      "duration": 4.3579727912090105,
      "text": "اقرأ المصحف، وكمّل من آخر صفحة قريتها."
    },
    {
      "id": 3,
      "start": 8.86886474520918,
      "duration": 3.8683932320489984,
      "text": "دَوَّر عَلَى أَيّ آيَة، وِافْهَم مَعْنَاهَا بِالتَّفْسِير."
    },
    {
      "id": 4,
      "start": 12.737257977258178,
      "duration": 6.305073977933185,
      "text": "عَلِّم عَلَى الْآيَات اللِّي تِهِمَّك، وِخَلِّيهَا فِي الْمُفَضَّلَة، وِاقْرَا بِرَاحْتَك بِالْوَضْع اللَّيْلِي."
    },
    {
      "id": 5,
      "start": 19.042331955191365,
      "duration": 3.8307218121987905,
      "text": "اسمع تلاوة مشاري العفاسي، وكرّر الآيات براحتك."
    },
    {
      "id": 6,
      "start": 22.873053767390154,
      "duration": 3.9050223596503857,
      "text": "وِاخْتَبِر حِفْظَك، وِتَابِع تَقَدُّمَك وِإِنْجَازَاتَك."
    },
    {
      "id": 7,
      "start": 26.77807612704054,
      "duration": 3.221923872959465,
      "text": "قُرْآنِي، رَفِيقَك مَع الْقُرْآن."
    }
  ]
}