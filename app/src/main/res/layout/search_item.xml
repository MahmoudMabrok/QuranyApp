<?xml version="1.0" encoding="utf-8"?>
<!-- One ayah search result: sura + ayah/page on top, the ayah text with the match highlighted. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:layoutDirection="rtl"
    app:cardBackgroundColor="@color/search_card_bg"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/search_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSearchSuraName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textStyle="bold"
                android:textAlignment="viewStart"
                android:textColor="@color/primary1"
                android:textSize="15sp"
                tools:text="البقرة" />

            <TextView
                android:id="@+id/tvSearchAyahNum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_search_chip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="@color/primary1"
                android:textSize="12sp"
                tools:text="الآية ١٦٣" />

            <TextView
                android:id="@+id/tvSearchPage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_search_chip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="@color/search_muted"
                android:textSize="12sp"
                tools:text="صفحة ٢٥" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSearchResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            app:fontFamily="@font/amiri_regular"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="6"
            android:textAlignment="viewStart"
            android:textColor="@color/search_ayah_text"
            android:textDirection="rtl"
            android:textSize="19sp"
            tools:text="وإلهكم إله واحد لا إله إلا هو الرحمن الرحيم" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
