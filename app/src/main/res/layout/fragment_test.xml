<?xml version="1.0" encoding="utf-8"?>
<!-- Memorization (حفظ) test: setup -> one question at a time -> result -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/search_screen_bg"
    android:clickable="true"
    android:focusable="true"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    tools:context=".feature.test_quran.TestFragment">

    <!-- teal app bar like the home screen; padded below the status bar in code -->
    <LinearLayout
        android:id="@+id/testToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary1"
        android:gravity="center_vertical"
        android:minHeight="?attr/actionBarSize"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <ImageView
            android:id="@+id/testBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/read_log_back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back_white" />

        <TextView
            android:id="@+id/testTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/memorization_test"
            android:textAlignment="viewStart"
            android:textColor="@android:color/white"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/testTotalPoints"
            android:contentDescription="@string/score_screen_title"
            android:foreground="?attr/selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_test_points"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            tools:text="١٢٠ نقطة" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/testScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ============ setup ============ -->
            <LinearLayout
                android:id="@+id/setupLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/setupIntro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:layout_marginBottom="8dp"
                    android:lineSpacingMultiplier="1.2"
                    android:text="@string/test_intro"
                    android:textAlignment="viewStart"
                    android:textColor="@color/search_muted"
                    android:textSize="14sp" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/TestCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/labelFrom"
                            style="@style/TestLabel"
                            android:text="@string/test_from" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <Spinner
                                android:id="@+id/spStartSura"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="2"
                                android:background="@drawable/bg_test_input"
                                android:spinnerMode="dialog" />

                            <EditText
                                android:id="@+id/edStartSuraAyah"
                                style="@style/TestNumberInput"
                                android:hint="@string/test_ayah_hint" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/labelTo"
                            style="@style/TestLabel"
                            android:layout_marginTop="14dp"
                            android:text="@string/test_to" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <Spinner
                                android:id="@+id/spEndSura"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="2"
                                android:background="@drawable/bg_test_input"
                                android:spinnerMode="dialog" />

                            <EditText
                                android:id="@+id/edEndSuraAyah"
                                style="@style/TestNumberInput"
                                android:hint="@string/test_ayah_hint" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvSetupRange"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textAlignment="viewStart"
                            android:textColor="@color/primary1"
                            android:textSize="13sp"
                            tools:text="٧ آيات: من الفاتحة ١ إلى الفاتحة ٧" />

                        <TextView
                            android:id="@+id/tvSetupError"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textAlignment="viewStart"
                            android:textColor="@color/test_wrong"
                            android:textSize="13sp"
                            android:visibility="gone"
                            tools:text="سورة البداية يجب أن تكون قبل سورة النهاية"
                            tools:visibility="visible" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTestSave"
                    style="@style/TestPrimaryButton"
                    android:layout_marginTop="16dp"
                    android:text="@string/test_full" />

                <TextView
                    android:id="@+id/tvFullDesc"
                    style="@style/TestHelp"
                    android:text="@string/test_full_desc" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTestSaveRandom"
                    style="@style/TestSecondaryButton"
                    android:layout_marginTop="12dp"
                    android:text="@string/test_random" />

                <TextView
                    android:id="@+id/tvRandomDesc"
                    style="@style/TestHelp"
                    android:text="@string/test_random_desc" />
            </LinearLayout>

            <!-- ============ question / feedback ============ -->
            <LinearLayout
                android:id="@+id/lnTestLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone"
                tools:visibility="gone">

                <TextView
                    android:id="@+id/tvTestRange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="viewStart"
                    android:textColor="@color/search_muted"
                    android:textSize="13sp"
                    tools:text="الفاتحة ١ – الفاتحة ٧" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/testProgress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:indicatorColor="@color/primary1"
                        app:trackColor="@color/search_chip_bg"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="6dp" />

                    <TextView
                        android:id="@+id/tvQuestionCounter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:textColor="@color/primary1"
                        android:textSize="13sp"
                        tools:text="السؤال ٢ من ٧" />
                </LinearLayout>

                <!-- the ayah shown as a cue -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/promptCard"
                    style="@style/TestCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvPromptLabel"
                            style="@style/TestLabel"
                            tools:text="الآية السابقة (الفاتحة ١)" />

                        <TextView
                            android:id="@+id/tvAyahToTestAfter"
                            style="@style/TestAyahText"
                            android:layout_marginTop="6dp"
                            tools:text="بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginHorizontal="4dp"
                    android:textAlignment="viewStart"
                    android:textColor="@color/search_ayah_text"
                    android:textSize="16sp"
                    tools:text="اكتب الآية التالية: الفاتحة ٢" />

                <EditText
                    android:id="@+id/edUserTextForAyahs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_test_input"
                    android:gravity="top|start"
                    android:hint="@string/test_answer_hint"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:minLines="3"
                    android:padding="12dp"
                    android:textAlignment="viewStart"
                    android:textColor="@color/search_ayah_text"
                    android:textColorHint="@color/search_muted"
                    android:textDirection="rtl"
                    android:textSize="19sp"
                    app:fontFamily="@font/amiri_regular" />

                <TextView
                    android:id="@+id/tvHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginHorizontal="4dp"
                    android:textAlignment="viewStart"
                    android:textColor="@color/test_extra"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="تلميح: الحمد لله …"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/answerButtons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCheckTest"
                        style="@style/TestPrimaryButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/test_check" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHint"
                        style="@style/TestSecondaryButton"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/test_hint" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSkip"
                        style="@style/TestTextButton"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/test_skip" />
                </LinearLayout>

                <!-- feedback after "تحقق" -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/feedbackCard"
                    style="@style/TestCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:visibility="gone"
                    app:strokeWidth="2dp"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvFeedbackTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textAlignment="viewStart"
                                android:textSize="17sp"
                                tools:text="ممتاز!"
                                tools:textColor="@color/test_correct" />

                            <TextView
                                android:id="@+id/tvFeedbackScore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:textColor="@android:color/white"
                                android:textSize="14sp"
                                tools:background="@color/test_correct"
                                tools:text="٩٥٪" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvFeedbackStats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAlignment="viewStart"
                            android:textColor="@color/search_muted"
                            android:textSize="12sp"
                            tools:text="٣ صحيحة · ١ ناقصة · ١ زائدة · +٤ نقاط" />

                        <TextView
                            android:id="@+id/tvYourAnswerLabel"
                            style="@style/TestLabel"
                            android:layout_marginTop="12dp"
                            android:text="@string/test_your_answer" />

                        <TextView
                            android:id="@+id/tvFeedbackDiff"
                            style="@style/TestAyahText"
                            android:layout_marginTop="4dp"
                            tools:text="الحمد لله رب العالمين" />

                        <TextView
                            android:id="@+id/tvLegend"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textAlignment="viewStart"
                            android:textSize="12sp"
                            tools:text="● صحيح  ● ناقص  ● زائد" />

                        <TextView
                            android:id="@+id/tvCorrectLabel"
                            style="@style/TestLabel"
                            android:layout_marginTop="12dp"
                            android:text="@string/test_correct_ayah" />

                        <TextView
                            android:id="@+id/tvCorrectAyah"
                            style="@style/TestAyahText"
                            android:layout_marginTop="4dp"
                            tools:text="الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNext"
                    style="@style/TestPrimaryButton"
                    android:layout_marginTop="12dp"
                    android:text="@string/test_next"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- ============ result ============ -->
            <LinearLayout
                android:id="@+id/resultLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/resultCircle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:indeterminate="false"
                        app:indicatorColor="@color/test_correct"
                        app:indicatorSize="140dp"
                        app:trackColor="@color/search_chip_bg"
                        app:trackThickness="10dp" />

                    <TextView
                        android:id="@+id/tvResultPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:textColor="@color/search_ayah_text"
                        android:textSize="32sp"
                        tools:text="٨٥٪" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvResultLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="20sp"
                    tools:text="جيد جدًا" />

                <TextView
                    android:id="@+id/tvResultRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textColor="@color/search_muted"
                    android:textSize="13sp"
                    tools:text="الفاتحة ١ – الفاتحة ٧" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/TestCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:id="@+id/resultStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetry"
                    style="@style/TestPrimaryButton"
                    android:layout_marginTop="16dp"
                    android:text="@string/test_retry" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNewTest"
                    style="@style/TestSecondaryButton"
                    android:layout_marginTop="8dp"
                    android:text="@string/test_new" />
            </LinearLayout>

            <!-- ============ no Quran data ============ -->
            <LinearLayout
                android:id="@+id/testEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="32dp"
                android:paddingVertical="96dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search_large" />

                <TextView
                    android:id="@+id/tvTestEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/test_no_data"
                    android:textColor="@color/search_muted"
                    android:textSize="15sp" />
            </LinearLayout>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
